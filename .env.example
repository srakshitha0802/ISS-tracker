# ==============================================================================
# ISS Tracker — Example Environment Variables Template
# ==============================================================================

# Copy this file to .env.local:
#   cp .env.example .env.local

# 1. Google Gemini AI API Key (Recommended - Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Alternative AI API Key (Optional: Groq / OpenAI)
AI_API_KEY=your_api_key_here
NEXT_PUBLIC_AI_API_KEY=your_api_key_here

# 3. Where The ISS At? API (Public, no key required)
NEXT_PUBLIC_ISS_API_ENDPOINT=https://api.wheretheiss.at/v1/satellites/25544

# 4. CARTO Map Tiles API Key
CARTO_API_KEY=cb1_4uy8_1_7f3b62bc006601121a15ee5c
NEXT_PUBLIC_CARTO_API_KEY=cb1_4uy8_1_7f3b62bc006601121a15ee5c
